rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- FONCTIONS DE SÉCURITÉ ---

    // 1. Est-ce que l'utilisateur est connecté ?
    function signedIn() {
      return request.auth != null;
    }

    // 2. Est-ce que l'utilisateur est ADMIN ?
    // On va chercher son profil dans la base de données pour vérifier son champ 'role'
    function isAdmin() {
      return signedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // --- RÈGLES ---

    // Par défaut : Tout est bloqué
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. UTILISATEURS
    match /users/{userId} {
      // Tout le monde peut voir les profils (pour afficher l'équipe)
      allow read: if signedIn();
      
      // Création : OK si c'est son propre UID
      allow create: if signedIn() && request.auth.uid == userId;
      
      // Modification : Soi-même ou un Admin
      allow update: if signedIn() && (request.auth.uid == userId || isAdmin());
      
      // Suppression : Admin seulement
      allow delete: if isAdmin();
    }

    // 2. OBJECTIFS (CRITIQUE)
    match /objectives/{objectiveId} {
      // Tout le monde peut VOIR les objectifs
      allow read: if signedIn();
      // SEUL UN ADMIN peut les modifier/créer/supprimer
      allow write: if isAdmin();
    }
    
    // 3. PRIMES
    match /primes_history/{primeId} {
      // Un utilisateur ne voit QUE ses propres primes. L'admin voit tout.
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      // SEUL UN ADMIN peut donner des primes
      allow write: if isAdmin();
    }
    
    // 4. CONFIGURATION GLOBALE
    match /config/{document=**} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
