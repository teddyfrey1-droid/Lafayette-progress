{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",

    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "$uid === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin'",

        "uid": {
          ".validate": "newData.isString() && newData.val() === $uid"
        },
        "email": {
          ".validate": "newData.isString() && (($uid === auth.uid && auth.token.email != null && newData.val() === auth.token.email) || root.child('users').child(auth.uid).child('role').val() === 'admin')"
        },
        "displayName": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "role": {
          ".validate": "newData.isString() && (newData.val() == data.val() || root.child('users').child(auth.uid).child('role').val() === 'admin') && (newData.val() != 'admin' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
        }
      }
    },

    "history": {
      ".read": "auth != null",
      "users": {
        "$uid": {
          ".write": "$uid === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin'"
        }
      }
    },

    "dailyMicro": {
      ".read": "auth != null",
      "$uid": {
        ".write": "$uid === auth.uid"
      }
    },

    "objectives": {
      ".read": "auth != null",
      ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    "directory": {
      ".read": "auth != null",
      ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    "logs": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["time", "lastSeen"]
    },

    "alerts": {
      ".read": "auth != null",
      ".indexOn": ["date"],
      "$alertId": {
        ".write": "(!data.exists() && auth.token.email == 'teddy.frey1@gmail.com') || (data.exists() && auth != null)"
      }
    },

    "feedbacks": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "updates": {
      ".read": "auth != null",
      ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    "settings": {
      ".read": "auth != null",
      ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    "mailGroups": {
      ".read": "auth != null",
      ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    "archives": {
      ".read": "auth != null",
      ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'"
    }
  }
}
